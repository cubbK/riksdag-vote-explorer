4pt; padding-right:1.4pt; padding-left:1.4pt; vertical-align:middle; background-color:#ffffff\">\r\n\t\t\t\t\t\t<p style=\"t-i:0pt; line-height:12pt\">\r\n\t\t\t\t\t\t\t<span style=\"font-size:10pt\">Från EU-budgeten finansierade insatser för asylsökande och flyktingar</span>\r\n\t\t\t\t\t\t</p>\r\n\t\t\t\t\t</td>\r\n\t\t\t\t\t<td style=\"width:68.1pt; padding-top:3.4pt; padding-right:1.4pt; padding-left:1.4pt; vertical-align:bottom; background-color:#ffffff\">\r\n\t\t\t\t\t\t<p style=\"t-i:0pt; text-align:right; line-height:12pt\">\r\n\t\t\t\t\t\t\t<span style=\"font-size:10pt\">665</span><span style=\"font-size:10pt\"> </span><span style=\"font-size:10pt\">000</span>\r\n\t\t\t\t\t\t</p>\r\n\t\t\t\t\t</td>\r\n\t\t\t\t\t<td style=\"width:68.1pt; padding-top:3.4pt; padding-right:1.4pt; padding-left:1.4pt; vertical-align:bottom; background-color:#ffffff\">\r\n\t\t\t\t\t\t<p style=\"t-i:0pt; text-align:right; line-height:12pt\">\r\n\t\t\t\t\t\t\t<span style=\"font-size:10pt\">−220</span><span style=\"font-size:10pt\"> </span><span style=\"font-size:10pt\">000</span>\r\n\t\t\t\t\t\t</p>\r\n\t\t\t\t\t</td>\r\n\t\t\t\t</tr>\r\n\t\t\t\t<tr style=\"height:8.5pt\">\r\n\t\t\t\t\t<td colspan=\"2\" style=\"width:201.3pt; border-bottom-style:solid; border-bottom-width:0.75pt; padding:3.4pt 4.25pt 1pt 1.4pt; vertical-align:middle; background-color:#ffffff\">\r\n\t\t\t\t\t\t<p style=\"t-i:0pt; line-height:12pt\">\r\n\t\t\t\t\t\t\t<span style=\"font-size:10pt; font-weight:bold\">Summa</span>\r\n\t\t\t\t\t\t</p>\r\n\t\t\t\t\t</td>\r\n\t\t\t\t\t<td style=\"width:68.1pt; border-bottom-style:solid; border-bottom-width:0.75pt; padding:3.4pt 1.4pt 1pt; vertical-align:bottom; background-color:#ffffff\">\r\n\t\t\t\t\t\t<p style=\"t-i:0pt; text-align:right; line-height:12pt\">\r\n\t\t\t\t\t\t\t<span style=\"font-size:10pt; font-weight:bold\">13</span><span style=\"font-size:10pt; font-weight:bold\"> </span><span style=\"font-size:10pt; font-weight:bold\">524</span><span style=\"font-size:10pt; font-weight:bold\"> </span><span style=\"font-size:10pt; font-weight:bold\">360</span>\r\n\t\t\t\t\t\t</p>\r\n\t\t\t\t\t</td>\r\n\t\t\t\t\t<td style=\"width:68.1pt; border-bottom-style:solid; border-bottom-width:0.75pt; padding:3.4pt 1.4pt 1pt; vertical-align:bottom; background-color:#ffffff\">\r\n\t\t\t\t\t\t<p style=\"t-i:0pt; text-align:right; line-height:12pt\">\r\n\t\t\t\t\t\t\t<span style=\"font-size:10pt; font-weight:bold\">−1</span><span style=\"font-size:10pt; font-weight:bold\"> </span><span style=\"font-size:10pt; font-weight:bold\">555</span><span style=\"font-size:10pt; font-weight:bold\"> </span><span style=\"font-size:10pt; font-weight:bold\">000</span>\r\n\t\t\t\t\t\t</p>\r\n\t\t\t\t\t</td>\r\n\t\t\t\t</tr>\r\n\t\t\t</table>\r\n\t\t\t<h2>\r\n\t\t\t\t<span>Anslag 1:1 Migrationsverket</span>\r\n\t\t\t</h2>\r\n\t\t\t<p class=\"Normalutanindragellerluft\">\r\n\t\t\t\t<a name=\"_Hlk210396587\"><span>Vänsterpartiet avslår regeringens höjning av anslag 1:1 om 28 miljoner kronor för 2026 med anledning av propositionen om ett nytt regelverk för som regeringen avser lämna in under 2026. Fr.o.m. 2027 beräknas anslaget öka med 9</span><span> </span><span>miljoner kronor med anledning av detta.</span></a>\r\n\t\t\t</p>\r\n\t\t\t<p>\r\n\t\t\t\t<span>Vänsterpartiet avslår regeringens höjning av anslag 1:1 om 30 miljoner kronor för 2026 med anledning av propositionen om skärpta krav för svenskt medborgarskap som regeringen avser lämna in under 2026. Fr.o.m. 2027 beräknas anslaget öka med 17 miljoner kronor med anledning av detta. </span>\r\n\t\t\t</p>\r\n\t\t\t<p>\r\n\t\t\t\t<span>Vänsterpartiet avslår regeringens höjning av anslag 1:1 om 102,5 miljoner kronor för 2026 (+2027 och 201 miljoner 2028) med anledning av propositionen om en ny mot</span><span>­</span><span>tagandelag som regeringen avser lämna in under 2026. År 2027 beräknas anslaget öka med 205 miljoner kronor och år 2028 med 201 miljoner kronor med anledning av detta. </span>\r\n\t\t\t</p>\r\n\t\t\t<p>\r\n\t\t\t\t<span>Vänsterpartiet avslår regeringens höjning av anslag 1:1 om 0,5 miljoner kronor för 2026 med anledning av betänkandet Etableringsboendelagen – ett nytt system för bosättning för vissa nyanlända som regeringen bedömer kommer kosta enligt ovan. Fr.o.m. 2027 beräknas anslaget öka med 1,5 miljoner kronor med anledning av detta.</span>\r\n\t\t\t</p>\r\n\t\t\t<p>\r\n\t\t\t\t<span>Vänsterpartiet avslår regeringens höjning av anslag 1:1 om 8</span><span> </span><span>miljoner kronor för 2026 med anledning av att regeringen under 2026 avser ta bort särregler för avgifter för tandvård för asylsökande och för vissa utlänningar som vistas i Sverige utan nödvändiga tillstånd. Anslaget förväntas öka med samma summa åren 2027 och 2028 med anledning av detta.</span>\r\n\t\t\t</p>\r\n\t\t\t<p>\r\n\t\t\t\t<span>Regeringens miniminivåutrednings slutbetänkande ska redovisas hösten 2025. Regeringen beräknar att förslagen kommer innebära ökade kostnader för handläggning av ärenden för Migrationsverket och höjer med anledning av detta anslag 1:1 med 41 </span><span style=\"letter-spacing:-0.05pt\">miljoner kronor år 2026. Vänsterpartiet står inte bakom utredningen och avslår höjningen</span><span> om 41 miljoner kronor 2026. År 2027 beräknas anslaget öka med 133 miljoner kronor och år 2028 med 124 miljoner kronor med anledning av detta. </span>\r\n\t\t\t</p>\r\n\t\t\t<p>\r\n\t\t\t\t<span>Vänsterpartiet ställer sig inte heller bakom den höjning om 10 miljoner kronor av anslag 1:1 som regeringen föreslår från år 2027 med anledning av propositionen om skärpta villkor för anhöriginvandring som regeringen avser lämna in under 2026. </span>\r\n\t\t\t</p>\r\n\t\t\t<p>\r\n\t\t\t\t<span>Sammanfattningsvis avslår Vänsterpartiet 210 miljoner kronor av regeringens satsningar på anslag 1:1 år 2026. </span>\r\n\t\t\t</p>\r\n\t\t\t<p>\r\n\t\t\t\t<span>Vänsterpartiet föreslår samtidigt att anslag 1:1 höjs med 30 miljoner kronor 2026 till följd av vårt förslag om att införa en amnesti för ensamkommande som vistats mer än ett år i Sverige (RUT 2025:770). Förslaget beskrivs närmare i Vänsterpartiets motion Svensk flyktingpolitik (mot. 2025/26:2798). </span>\r\n\t\t\t</p>\r\n\t\t\t<p>\r\n\t\t\t\t<span>Sammantaget innebär Vänsterpartiets förslag att anslaget minskas med 180 miljoner kronor jämfört med regeringens förslag 2026. </span>\r\n\t\t\t</p>\r\n\t\t\t<h2>\r\n\t\t\t\t<span style=\"-aw-bookmark-end:_Hlk210396587\"></span><span>Anslag 1:2 Ersättningar och bostadskostnader</span>\r\n\t\t\t</h2>\r\n\t\t\t<p class=\"Normalutanindragellerluft\">\r\n\t\t\t\t<span>Vänsterpartiet avslår regeringens höjning av anslag 1:2 om 53 miljoner kronor för 2026 med anledning av propositionen om en ny mottagandelag som regeringen avser lämna in under 2026. År 2027 beräknas anslaget öka med 114 miljoner kronor och år 2028 med 118 miljoner kronor med anledning av detta. </span>\r\n\t\t\t</p>\r\n\t\t\t<p>\r\n\t\t\t\t<span>Vänsterpartiet föreslår att anslag 1:2 minskas med 110 miljoner kronor till följd av vårt förslag om att införa en amnesti för ensamkommande (RUT 2025:770). Förslaget beskrivs närmare i Vänsterpartiets motion Svensk flyktingpolitik (mot. 2025/26:2798). </span>\r\n\t\t\t</p>\r\n\t\t\t<p>\r\n\t\t\t\t<span>Vänsterpartiet föreslår vidare att anslag 1:2 höjs med 185 miljoner kronor år 2026 till följd av vårt förslag om att höja dagersättningen för asylsökande (RUT 2025:769). Förslaget beskrivs närmare i motionen Svensk flyktingpolitik (mot. 2025/26:2798). I förslaget ingår Vänsterpartiets generella höjning av riksnormen för försörjningsstöd med 1</span><span> </span><span>000 kronor per månad, utgiftsområde 25, anslag 1:1 Kommunalekonomisk utjämning. Det förslaget beskrivs närmare i Vänsterpartiets motion Starkare skydd för barns rättigheter (mot. 2025/26:2816).</span><span style=\"-aw-import:spaces\">  </span><span style=\"-aw-import:spaces\"> </span>\r\n\t\t\t</p>\r\n\t\t\t<p>\r\n\t\t\t\t<span>Sammantaget innebär Vänsterpartiets förslag att anslag 1:2 ökas med 22 miljoner kronor jämfört med regeringens förslag 2026. </span>\r\n\t\t\t</p>\r\n\t\t\t<h1>\r\n\t\t\t\t<span>Anslag 1:3 Migrationspolitiska åtgärder</span>\r\n\t\t\t</h1>\r\n\t\t\t<p class=\"Normalutanindragellerluft\">\r\n\t\t\t\t<span>Vänsterpartiet avvisar regeringens förslag kring återvandringsprojekt och det kraftigt höjda återvändandestödet som regeringen beslutat om inom anslag 1:3. Vänsterpartiet minskar därmed anslag 1:3 med 1</span><span> </span><span>320 miljoner kronor 2026. </span>\r\n\t\t\t</p>\r\n\t\t\t<h1>\r\n\t\t\t\t<span>1:4 Domstolsprövning i utlänningsmål </span>\r\n\t\t\t</h1>\r\n\t\t\t<p class=\"Normalutanindragellerluft\">\r\n\t\t\t\t<span>Vänsterpartiet avslår regeringens höjning av anslag 1:4 om 1</span><span> </span><span>miljon kronor för 2026 med anledning av regeringens proposition om ett nytt regelverk för uppsikt och förvar. </span>\r\n\t\t\t</p>\r\n\t\t\t<p>\r\n\t\t\t\t<span>Regeringens miniminivåutrednings slutbetänkande ska redovisas hösten 2025. Regeringen beräknar att förslagen kommer innebära ökade kostnader för migrations</span><span>­</span><span>domstolarna och höjer med anledning av detta anslag 1:4 med 85 miljoner kronor år 2027 och 99 miljoner kronor för 2028. Vänsterpartiet står inte bakom utredningen och höjningarna de nämnda 2 åren. </span>\r\n\t\t\t</p>\r\n\t\t\t<p>\r\n\t\t\t\t<span>Sammantaget innebär Vänsterpartiets förslag att anslag 1:4 minskar med 1</span><span> </span><span>miljon kronor jämfört med regeringens förslag 2026. </span>\r\n\t\t\t</p>\r\n\t\t\t<h2>\r\n\t\t\t\t<span>Anslag 1:6 Offentligt biträde i utlänningsärenden</span>\r\n\t\t\t</h2>\r\n\t\t\t<p class=\"Normalutanindragellerluft\">\r\n\t\t\t\t<span>Vänsterpartiet avslår regeringens minskning av anslag 1:6 om 159 miljoner kronor för 2026 med anledning av regeringens begränsningar av asylsökandes rätt till kostnadsfri rådgivning. </span>\r\n\t\t\t</p>\r\n\t\t\t<h2>\r\n\t\t\t\t<span>1:7 Utresor för avvisade och utvisade</span>\r\n\t\t\t</h2>\r\n\t\t\t<p class=\"Normalutanindragellerluft\">\r\n\t\t\t\t<span>Vänsterpartiet avslår regeringens höjning av anslag 1:7 om 15 miljoner kronor för 2026 med anledning av propositionen om ett skärpt regelverk om utvisning på grund av brott som regeringen avser lämna in under 2026 och som beräknas medföra ökade kostnader för Kriminalvården för att verkställa fler utvisningar. </span>\r\n\t\t\t</p>\r\n\t\t\t<h2>\r\n\t\t\t\t<span>1:8 Från EU-budgeten finansierade insatser för asylsökande och flyktingar </span>\r\n\t\t\t</h2>\r\n\t\t\t<p class=\"Normalutanindragellerluft\">\r\n\t\t\t\t<span>Vänsterpartiet står inte bakom EU:s migrations- och asylpakt. Vänsterpartiet avslår höjningen av anslag 1:8 om 220 miljoner kronor för 2026 som regeringen avsatt i syfte att genomföra EU:s migrations- och asylpakt. </span>\r\n\t\t\t</p>\r\n\t\t\t<div style=\"-aw-sdt-tag:'CC_Underskrifter'; -aw-sdt-title:'CC_Underskrifter'\">\r\n\t\t\t\t<p>\r\n\t\t\t\t\t<span style=\"-aw-import:ignore\"> </span>\r\n\t\t\t\t</p>\r\n\t\t\t\t<p>\r\n\t\t\t\t\t<span style=\"-aw-import:ignore\"> </span>\r\n\t\t\t\t</p>\r\n\t\t\t</div>\r\n\t\t\t<table cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%; border-collapse:collapse\">\r\n\t\t\t\t<tr style=\"page-break-inside:avoid\">\r\n\t\t\t\t\t<td style=\"width:1%; padding-right:5.4pt; padding-left:5.4pt; vertical-align:bottom\">\r\n\t\t\t\t\t\t<p class=\"Underskrifter\" style=\"margin-bottom:0pt\">\r\n\t\t\t\t\t\t\t<span>Nooshi Dadgostar (V)</span>\r\n\t\t\t\t\t\t</p>\r\n\t\t\t\t\t</td>\r\n\t\t\t\t\t<td style=\"width:1%; padding-right:5.4pt; padding-left:5.4pt; vertical-align:bottom\">\r\n\t\t\t\t\t\t<p class=\"Underskrifter\" style=\"margin-bottom:0pt\">\r\n\t\t\t\t\t\t\t<span style=\"-aw-import:ignore\"> </span>\r\n\t\t\t\t\t\t</p>\r\n\t\t\t\t\t</td>\r\n\t\t\t\t</tr>\r\n\t\t\t\t<tr style=\"page-break-inside:avoid\">\r\n\t\t\t\t\t<td style=\"width:1%; padding-right:5.4pt; padding-left:5.4pt; vertical-align:bottom\">\r\n\t\t\t\t\t\t<p class=\"Underskrifter\"