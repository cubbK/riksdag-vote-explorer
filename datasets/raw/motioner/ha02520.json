tustext","text":"Ärendet är avslutat","dok_id":"HA02520","systemdatum":"2023-04-12 19:00:21"}]},"dokbilaga":{"bilaga":[{"dok_id":"HA02520","subtitel":"av Markus Wiechel (SD)","filnamn":"mot_202223__520.pdf","filstorlek":"88381","filtyp":"pdf","titel":"Gårdsnära slakt och slakttransporter","fil_url":"https://data.riksdagen.se/fil/D2244695-92BB-4A16-8D08-47D7560838CF"},{"dok_id":"HA02520","subtitel":"av Markus Wiechel (SD)","filnamn":"mot_202223__520.docx","filstorlek":"76122","filtyp":"docx","titel":"Gårdsnära slakt och slakttransporter","fil_url":"https://data.riksdagen.se/fil/1D1989E2-8EC9-45B9-8AE1-751FD023F01C"}]},"dokreferens":{"referens":{"referenstyp":"behandlas_i","uppgift":"2022/23:MJU9","ref_dok_id":"HA01MJU9","ref_dok_typ":"bet","ref_dok_rm":"2022/23","ref_dok_bet":"MJU9","ref_dok_titel":"Djurskydd","ref_dok_subtitel":null,"ref_dok_subtyp":"bet","ref_dok_dokumentnamn":"Betänkande"}}}}