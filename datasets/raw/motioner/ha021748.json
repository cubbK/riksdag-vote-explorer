{"intressent_id":"0112333043027","namn":"Rasmus Giertz","partibet":"SD","ordning":"1","roll":"undertecknare"},{"intressent_id":"0861521539920","namn":"Aron Emilsson","partibet":"SD","ordning":"2","roll":"undertecknare"},{"intressent_id":"0204240926023","namn":"Markus Wiechel","partibet":"SD","ordning":"3","roll":"undertecknare"},{"intressent_id":"0365748677411","namn":"Mats Nordberg","partibet":"SD","ordning":"4","roll":"undertecknare"},{"intressent_id":"0279488554424","namn":"Alexander Christiansson","partibet":"SD","ordning":"5","roll":"undertecknare"}]},"dokuppgift":{"uppgift":[{"kod":"motkat","namn":"Motionskategori","text":"Fristående motion","dok_id":"HA021748","systemdatum":"2023-09-29 12:41:33"},{"kod":"tilldelat","namn":"Tilldelat","text":"Utrikesutskottet","dok_id":"HA021748","systemdatum":"2023-09-29 12:41:33"},{"kod":"statustext","namn":"statustext","text":"Ärendet är avslutat","dok_id":"HA021748","systemdatum":"2023-04-26 17:36:17"}]},"dokbilaga":{"bilaga":[{"dok_id":"HA021748","subtitel":"av Rasmus Giertz m.fl. (SD)","filnamn":"mot_202223__1748.pdf","filstorlek":"90670","filtyp":"pdf","titel":"Erkännande av folkmord","fil_url":"https://data.riksdagen.se/fil/4F4A394E-0B5A-4C80-B241-673FB1897A9C"},{"dok_id":"HA021748","subtitel":"av Rasmus Giertz m.fl. (SD)","filnamn":"mot_202223__1748.docx","filstorlek":"74917","filtyp":"docx","titel":"Erkännande av folkmord","fil_url":"https://data.riksdagen.se/fil/FA51A161-B460-4BE6-BDFA-6C8B2B10B57E"}]},"dokreferens":{"referens":[{"referenstyp":"behandlas_i","uppgift":"2022/23:UU14","ref_dok_id":"HA01UU14","ref_dok_typ":"bet","ref_dok_rm":"2022/23","ref_dok_bet":"UU14","ref_dok_titel":"Ukraina","ref_dok_subtitel":null,"ref_dok_subtyp":"bet","ref_dok_dokumentnamn":"Betänkande"},{"referenstyp":"behandlas_i","uppgift":"2022/23:UU7","ref_dok_id":"HA01UU7","ref_dok_typ":"bet","ref_dok_rm":"2022/23","ref_dok_bet":"UU7","ref_dok_titel":"Internationella relationer m.m.","ref_dok_subtitel":null,"ref_dok_subtyp":"bet","ref_dok