6","subtitel":"av Oliver Rosengren m.fl. (M)","filnamn":"mot_202425__2416.pdf","filstorlek":"100816","filtyp":"pdf","titel":"Rimliga regler för alkoholservering","fil_url":"https://data.riksdagen.se/fil/C6B19C22-3511-45C2-8B18-7203DEC58E39"},{"dok_id":"HC022416","subtitel":"av Oliver Rosengren m.fl. (M)","filnamn":"mot_202425__2416.docx","filstorlek":"76479","filtyp":"docx","titel":"Rimliga regler för alkoholservering","fil_url":"https://data.riksdagen.se/fil/32CF448E-E44F-4F11-A588-53AB18711B08"}]},"dokreferens":{"referens":{"referenstyp":"behandlas_i","uppgift":"2024/25:SoU13","ref_dok_id":"HC01SoU13","ref_dok_typ":"bet","ref_dok_rm":"2024/25","ref_dok_bet":"SoU13","ref_dok_titel":"Alkohol, narkotika, dopning, tobak och spel","ref_dok_subtitel":null,"ref_dok_subtyp":"bet","ref_dok_dokumentnamn":"Betänkande"}}}}