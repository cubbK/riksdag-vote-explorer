ok_id":"HC022890","subtitel":"av Richard Jomshof m.fl. (SD)","filnamn":"mot_202425__2890.pdf","filstorlek":"95426","filtyp":"pdf","titel":"Straffrättsliga frågor","fil_url":"https://data.riksdagen.se/fil/6396816E-55C1-4CBE-9AF2-FC4E68748D50"},{"dok_id":"HC022890","subtitel":"av Richard Jomshof m.fl. (SD)","filnamn":"mot_202425__2890.docx","filstorlek":"76432","filtyp":"docx","titel":"Straffrättsliga frågor","fil_url":"https://data.riksdagen.se/fil/93FD8609-8C90-4790-811E-44829D6BE929"}]},"dokreferens":{"referens":[{"referenstyp":"behandlas_i","uppgift":"2024/25:JuU10","ref_dok_id":"HC01JuU10","ref_dok_typ":"bet","ref_dok_rm":"2024/25","ref_dok_bet":"JuU10","ref_dok_titel":"Straffrättsliga frågor","ref_dok_subtitel":null,"ref_dok_subtyp":"bet","ref_dok_dokumentnamn":"Betänkande"},{"referenstyp":"behandlas_i","uppgift":"2024/25:JuU15","ref_dok_id":"HC01JuU15","ref_dok_typ":"bet","ref_dok_rm":"2024/25","ref_dok_bet":"JuU15","ref_dok_titel":"Polisfrågor","ref_dok_subtitel":null,"ref_dok_subtyp":"bet","ref_dok_dokumentnamn":"Betänkande"},{"referenstyp":"behandlas_i","uppgift":"2024/25:SoU16","ref_dok_id":"HC01SoU16","ref_dok_typ":"bet","ref_dok_rm":"2024/25","ref_dok_bet":"SoU16","ref_dok_titel":"Hälso- och sjukvårdens organisation","ref_dok_subtitel":null,"ref_dok_subtyp":"bet","ref_dok_dokumentnamn":"Betänkande"}]}}}